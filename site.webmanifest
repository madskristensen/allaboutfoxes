---
layout: null
permalink: /site.webmanifest
sitemap: false
---
{
  "id": {{ '/' | relative_url | jsonify }},
  "name": "All About Foxes",
  "short_name": "Fox Field Guide",
  "description": {{ site.description | jsonify }},
  "lang": "en",
  "start_url": {{ '/' | relative_url | jsonify }},
  "scope": {{ '/' | relative_url | jsonify }},
  "display": "standalone",
  "background_color": "#faf7ef",
  "theme_color": "#244c3d",
  "icons": [
    { "src": {{ '/assets/images/icon-192.png' | relative_url | jsonify }}, "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": {{ '/assets/images/icon-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": {{ '/assets/images/icon-maskable-512.png' | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
